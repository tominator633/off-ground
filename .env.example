# Zkopíruj do .env.local (lokálně) nebo nastav ve Vercelu: Project → Settings → Environment Variables.

# Veřejná adresa webu (kanonické odkazy). Na Vercelu se bez ní použije produkční URL projektu.
NEXT_PUBLIC_SITE_URL=

# "true" = vyhledávače smí web indexovat. Dokud je web soukromý, nech prázdné.
SITE_INDEXING=

# Cloudflare Turnstile (ochrana formuláře proti botům) – https://dash.cloudflare.com → Turnstile.
# Pro lokální vývoj stačí oficiální testovací klíče, které vždy projdou:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Odesílání zpráv z kontaktního formuláře přes Resend – https://resend.com
# Bez vlastní ověřené domény jde posílat jen z onboarding@resend.dev na e-mail účtu Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
